# Copy to .env and fill in. Real environment variables override this file.
# --- Qwen language layer (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=          (hosted providers only)
LLM_MODE=smart
# Chain more providers (each is tried in order if the one before fails or is rate limited):
# LLM2_BASE_URL=https://openrouter.ai/api/v1
# LLM2_API_KEY=
# LLM2_MODEL=qwen/qwen3-coder:free
# LLM3_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM3_API_KEY=
# LLM3_MODEL=
# LLM_FALLBACK_MODELS=another-model,openrouter/free   (tried in order if the main model fails)
# Website without local setup: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=...  LLM_MODEL=<a free qwen id>
# --- Cost protection ---
# LLM_DAILY_CAP=500     max Qwen calls per UTC day, then brain-only
# LLM_IP_HOURLY=20      max Qwen calls per IP per hour
# --- Learning ---
# LEARN_MIN_UPS=1       thumbs-ups (from different sessions) before a Qwen answer is learned
# --- Persistence (optional; survives Render free-plan restarts) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# --- Admin ---
# ADMIN_KEY=
