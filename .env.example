# Copy to .env and fill in. Real environment variables override this file.
# --- Qwen language layer (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=          (hosted providers only)
LLM_MODE=fallback
# --- Cost protection ---
# LLM_DAILY_CAP=500     max Qwen calls per UTC day, then brain-only
# LLM_IP_HOURLY=20      max Qwen calls per IP per hour
# --- Learning ---
# LEARN_MIN_UPS=1       thumbs-ups (from different sessions) before a Qwen answer is learned
# --- Persistence (optional; survives Render free-plan restarts) ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# --- Admin ---
# ADMIN_KEY=
